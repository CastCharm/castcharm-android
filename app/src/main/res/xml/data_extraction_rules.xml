<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer exclusion rules used on Android 12+.
  Mirrors backup_rules.xml so the same credential files are excluded from both
  cloud-backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.json"/>
        <exclude domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.json"/>
        <exclude domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
